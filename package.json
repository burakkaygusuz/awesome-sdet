{
  "name": "awesome-sdet",
  "version": "1.3.0",
  "private": true,
  "description": "Enterprise SDET Agent Plugin & MCP Server featuring deterministic AST test verification and policy-bounded repair.",
  "files": [
    "dist",
    "skills",
    "agents",
    "servers/dist",
    "servers/package.json",
    "plugin.json",
    "mcp.json",
    "AGENTS.md"
  ],
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "scripts": {
    "build": "pnpm --dir servers build && tsc",
    "typecheck": "tsc --noEmit",
    "validate": "node dist/scripts/validate.js",
    "test": "pnpm run build && vitest run",
    "test:evals": "vitest run evals",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "audit": "pnpm audit --audit-level high",
    "audit:skills": "skills-check audit",
    "audit:all": "pnpm audit --audit-level high && skills-check audit",
    "release": "node dist/scripts/release.js",
    "release:patch": "node dist/scripts/release.js patch",
    "release:minor": "node dist/scripts/release.js minor",
    "release:major": "node dist/scripts/release.js major",
    "commit": "cz",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@repomix/tree-sitter-wasms": "^0.1.17",
    "@types/node": "^26.2.0",
    "commitizen": "^4.3.2",
    "cz-git": "^1.13.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-markdownlint": "^0.10.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "skills-check": "^1.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "web-tree-sitter": "^0.26.12"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "type": "module"
}
