{
  "name": "awesome-sdet",
  "version": "1.1.0",
  "private": true,
  "description": "Enterprise SDET Agent Plugin for AI coding assistants featuring test automation skills and a secure Model Context Protocol (MCP) server.",
  "files": [
    "dist",
    "skills",
    "agents",
    "servers/dist",
    "plugin.json",
    "mcp.json",
    "AGENTS.md"
  ],
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm --dir servers build && tsc",
    "typecheck": "tsc --noEmit",
    "validate": "node dist/scripts/validate.js",
    "test": "pnpm run build && vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "audit": "pnpm audit --audit-level high",
    "audit:skills": "skills-check audit",
    "audit:all": "pnpm audit --audit-level high && skills-check audit",
    "release": "node dist/scripts/release.js",
    "release:patch": "node dist/scripts/release.js patch",
    "release:minor": "node dist/scripts/release.js minor",
    "release:major": "node dist/scripts/release.js major",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-markdownlint": "^0.10.1",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "skills-check": "^1.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "type": "module",
  "pnpm": {
    "overrides": {
      "hono@<4.12.34": ">=4.12.34",
      "undici@<6.28.0": ">=6.28.0"
    }
  }
}
