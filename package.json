{
  "name": "awesome-sdet",
  "version": "1.0.0",
  "private": true,
  "description": "Skills and agents registry for SDETs",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.ts",
    "lint:skills": "node scripts/validate.ts",
    "test": "pnpm --dir servers test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "audit": "pnpm audit --audit-level high",
    "audit:skills": "skills-check audit",
    "audit:all": "pnpm audit --audit-level high && skills-check audit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-markdownlint": "^0.10.1",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "skills-check": "^1.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "zod": "^4.4.3"
  },
  "type": "module",
  "pnpm": {
    "overrides": {
      "hono@<4.12.34": ">=4.12.34",
      "undici@<6.28.0": ">=6.28.0"
    }
  }
}
