{
  "name": "sdet-mcp",
  "version": "1.2.0",
  "description": "Modular, test-framework-based MCP server following official modelcontextprotocol/servers architecture",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc && node -e \"fs.cpSync('src', 'dist', { recursive: true, filter: (f) => !f.endsWith('.ts') })\"",
    "test": "pnpm --dir .. test -- test/mcp",
    "test:watch": "pnpm --dir .. test:watch -- test/mcp",
    "start": "node dist/index.js",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/fastify": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "fastify": "^5.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
