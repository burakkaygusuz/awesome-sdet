{
  "name": "sdet-mcp",
  "version": "1.3.1",
  "description": "Modular, test-framework-based MCP server following official modelcontextprotocol/servers architecture",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc && node -e \"fs.cpSync('src', 'dist', { recursive: true, filter: (f) => !f.endsWith('.ts') })\"",
    "test": "pnpm --dir .. test -- test/mcp",
    "test:watch": "pnpm --dir .. test:watch -- test/mcp",
    "start": "node dist/index.js",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@repomix/tree-sitter-wasms": "^0.1.17",
    "web-tree-sitter": "^0.26.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
